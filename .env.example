# =========================================================================
# vn-news-summarizer — local-only configuration
# Copy to .env and edit. NEVER commit .env.
#
# Only two variables are needed for the web UI demo (`make api` +
# `cd apps/web && npm run dev`). Everything else has a sensible default
# in `packages/common/src/vn_news_common/settings.py` — override there or
# via environment variables only if you need to.
# =========================================================================

# Where the ViT5 + LoRA adapter lives. Defaults to a local directory that
# `scripts/bootstrap_model.sh` populates from a tarball — no Hub auth needed.
MODEL_PATH=./models/vit5-news-v2

# Backend URL for the Next.js frontend. Default matches `make api`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional ------------------------------------------------------------
# Only set HF_TOKEN if you want MODEL_PATH to point at a private HF Hub
# adapter repo (e.g. Gthgfuiss123/vit5-news-vi-lora-v2). For the local
# tarball workflow you can leave this unset.
# HF_TOKEN=hf_xxx
